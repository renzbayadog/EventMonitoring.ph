@page "/account/users/profile"
@using System.Security.Claims
@using EventMonitoring.ph.Components.Pages.General
@using EventMonitoring.ph.Components.Pages.content
@using Mapster
@using Microsoft.AspNetCore.SignalR.Client
@using System.Security.Claims
@using MudBlazor
@using codegen.Extensions
@using codegen.ViewModels
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Manage Your Account</PageTitle>
<TwoSectionsTemplate>
    <Col12Template>
        @* <AdminHomeHeader /> *@
        @* <NetcodeHubBreadCrumb BreadCrumbs="crumbs" ReloadPageOnClick="true" BackgroundColor="@BreadCrumbBackgroundColor.PrimarySubtle()" /> *@

        <section class="vh-100" style="background-color: #f4f5f7;">
            <div class="container py-5 h-100">
                <div class="row d-flex justify-content-center align-items-center h-100">
                    <div class="col col-lg-6 mb-4 mb-lg-0">
                        <div class="card mb-3" style="border-radius: .5rem;">
                            
                                @if(User != null)
                                {

                            <div class="row g-0">
                                <div class="col-md-4 gradient-custom text-center text-white"
                                     style="border-top-left-radius: .5rem; border-bottom-left-radius: .5rem;">
                                    <img src="https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-chat/ava1-bg.webp"
                                         alt="Avatar" class="img-fluid my-5" style="width: 80px;" />
                                    <h5>@User?.UserInfo?.FirstName @User?.UserInfo?.LastName</h5>
                                    <p>@User?.UserOtherInfo?.TypeOfWork</p>
                                    <i class="far fa-edit mb-5"></i>
                                </div>
                                    <div class="col-md-8">
                                        <div class="card-body p-4">
                                            <h6>Personal Information</h6>
                                            <hr class="mt-0 mb-4">
                                            <div class="row pt-1">
                                                <div class="col-6 mb-3">
                                                    <h6>Name</h6>
                                                    <p class="text-muted">@User?.UserInfo?.FirstName @User.UserInfo?.LastName</p>
                                                </div>
                                                <div class="col-6 mb-3">
                                                    <h6>Role</h6>
                                                    <p class="text-muted">@User?.RoleName</p>
                                                </div>
                                            </div>
                                            <h6>Contact Information</h6>
                                            <hr class="mt-0 mb-4">
                                            <div class="row pt-1">
                                                <div class="col-6 mb-3">
                                                    <h6>Email</h6>
                                                    <p class="text-muted">@User?.Email</p>
                                                </div>
                                                <div class="col-6 mb-3">
                                                    <h6>Phone</h6>
                                                    <p class="text-muted">@User?.UserInfo?.PhoneNumber</p>
                                                </div>
                                            </div>
                                            <h6>Others</h6>
                                            <hr class="mt-0 mb-4">
                                            <div class="row pt-1">
                                                <div class="col-6 mb-3">
                                                    <h6>Home Address</h6>
                                                    <p class="text-muted">@User?.UserOtherInfo?.HomeAddress</p>
                                                </div>
                                                <div class="col-6 mb-3">
                                                    <h6>Plate Number</h6>
                                                    <p class="text-muted">@User?.UserOtherInfo?.PlateNumber</p>
                                                </div>

                                                <div class="col-6 mb-3">
                                                    <h6>Type of Participant</h6>
                                                    <p class="text-muted">@User?.UserOtherInfo?.TypeOfVisitor</p>
                                                </div>
                                                <div class="col-6 mb-3">
                                                    <h6>Type of Work</h6>
                                                    <p class="text-muted">@User?.UserOtherInfo?.TypeOfWork</p>
                                                </div>
                                                <div class="col-6 mb-3">
                                                    <button @onclick="()=>ManageUserClicked(User)" class="btn btn-warning btn-custom float-md-end">
                                                        <i class="fa fa-edit"></i> Update Details
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="d-flex justify-content-start">
                                                <a href="#!"><i class="fab fa-facebook-f fa-lg me-3"></i></a>
                                                <a href="#!"><i class="fab fa-twitter fa-lg me-3"></i></a>
                                                <a href="#!"><i class="fab fa-instagram fa-lg"></i></a>
                                            </div>
                                        </div>
                                    </div>
                            </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </Col12Template>
    <FooterTemplate>
        <Footer />
    </FooterTemplate>
</TwoSectionsTemplate>
@if (ChangeUserClaim == null)
{

}
else
{
    <Modal @bind-Open="IsOpen"
    BootstrapClass="border-info rounded p-2 ml-2 mr-2 align-item-conter position-absolute top-50 start-50 translate-middle"
    CustomStyle="width:300px;margin-top:10px;">
        <ContentContent>
            <div class="card p-3 shadow-lg border-success">
                <div class="card-title text-center text-info d-flex justify-content-between">
                    <i class="d-flex mdi mdi-pencil text-primary fs-3"></i>
                    <span class="d-flex">Manage Account</span>
                    <i class="mdi mdi-close text-danger fw-bold menu-icon fs-3 d-flex"
                    style="cursor:pointer" @onclick="()=>CloseModalDialog()"></i>
                </div>
                <div class="card-body">
                    <EditForm Model="ChangeUserClaim" OnValidSubmit="SaveChanges">
                        <DataAnnotationsValidator />
                        <div class="form-group mt-3">
                            <label class="form-label">FIrst Name</label>
                            <input @bind="ChangeUserClaim.UserInfo.Id" id="js-eventremarks" class="form-control" hidden />

                            <input @bind="ChangeUserClaim.UserInfo.FirstName" id="js-eventremarks" class="form-control" />
                        </div>

                        <div class="form-group mt-3">
                            <label class="form-label">Middle Initials</label>
                            <input @bind="ChangeUserClaim.UserInfo.MiddleInitial" id="js-eventremarks" class="form-control" />
                        </div>

                        <div class="form-group mt-3">
                            <label class="form-label">Last Name</label>
                            <input @bind="ChangeUserClaim.UserInfo.LastName" id="js-eventremarks" class="form-control" />
                        </div>

                        <div class="form-group mt-3">
                            <label class="form-label">User Name</label>
                            <input @bind="ChangeUserClaim.UserInfo.UserName" id="js-eventremarks" class="form-control" disabled />
                        </div>

                        <div class="form-group mt-3">
                            <label class="form-label">Email</label>
                            <input @bind="ChangeUserClaim.UserInfo.Email" id="js-eventremarks" class="form-control" disabled />
                        </div>

                        <div class="form-group mt-3">
                            <label class="form-label">Phone Number</label>
                            <input @bind="ChangeUserClaim.UserInfo.PhoneNumber" id="js-eventremarks" class="form-control" />
                        </div>

                        <div class="form-group mt-3">
                            <label class="form-label">Plate Number</label>
                            <input @bind="ChangeUserClaim.UserOtherInfo.PlateNumber" id="js-eventremarks" class="form-control" />
                        </div>

                        <div class="form-group mt-3">
                            <label class="form-label">Type of Work</label>
                            <input @bind="ChangeUserClaim.UserOtherInfo.TypeOfWork" id="js-eventremarks" class="form-control" />
                        </div>

                        <div class="form-group mt-3">
                            <label class="form-label">Home Address</label>
                            <input @bind="ChangeUserClaim.UserOtherInfo.HomeAddress" id="js-eventremarks" class="form-control" />
                        </div>

                        <div class="form-group mt-3">
                            @if (Loading)
                            {
                                <GenericSpinnerButton ButtonClass="btn btn-info btn-sm float-end" Text="Saving..." />
                            }
                            else
                            {
                                <button class="btn btn-info float-end btn-sm" type="Submit">Save</button>
                            }
                        </div>
                    </EditForm>
                </div>
            </div>
        </ContentContent>
    </Modal>
}
<NetcodeHubToast Duration="5000" IconClass="mdi mdi-content-duplicate menu-icon fs-4" @ref="ToastComponent" />

@code {
    [CascadingParameter]
    public Task<AuthenticationState> userAuthState { get; set; }
    private Dictionary<string, string> crumbs = new Dictionary<string, string>()
    {
        {"Home", "app/home"},
        {"Manage Account", null!}
    };
    public bool IsOpen { get; set; }
    void OpenModal() => IsOpen = true;
    private ClaimGetUserResponseDTO User = null;
    private ClaimChangeUserRequestDTO ChangeUserClaim = null;
    NetcodeHubToast ToastComponent;
    private HubConnection hub;
    private UserCreateRequestDTO UserModel { get; set; } = new();
    // List<string> Policies = new List<string>(){
    //         new string(Policy.AdminPolicy),
    //         new string(Policy.UserPolicy),
    //         new string(Policy.ManagerPolicy)
    // };
    // List<string> Roles = new List<string>(){
    //         new string(Policy.RoleClaim.User),
    //         new string(Policy.RoleClaim.Manager),
    //         new string(Policy.RoleClaim.Admin)
    // };
    private bool Loading = false;
    private IEnumerable<ClaimGetUserResponseDTO> UsersClaim { get; set; } = [];

    public async Task GetUserUpdatedDetails()
    {
        var userEmail = (await userAuthState!).User.Claims.FirstOrDefault(_ => _.Type == ClaimTypes.Email)!.Value;
        var userData = await accountService.GetUserWithClaimEmailAsync(userEmail);
        User = userData;
    }

    protected async override Task OnInitializedAsync()
    {
        if ((!customAuthorizationService.CustomClaimChecker((await userAuthState!).User, DefaultClaims.ManageUser)))
            NavManager.NavigateTo("Account/Access-Denied");

        await GetUserUpdatedDetails();
        // passwordState.Changed += StateHasChanged;
        // homeGenericState.StateChanged += StateButtonClicked;

        // hub = netcodeHubConnectionService.GetHubConnection();
        // hub.On<string>("Notify", async (clientId) =>
        // {
        //     await CallWhenNotified();
        // });

        // if (hub == null)
        // {
        //     await hub!.StartAsync();
        // }
    }

    async Task CallWhenNotified()
    {
        await InvokeAsync(async () =>
        {
            StateHasChanged();
            await adminActiveOrderCountState.GetActiveEventCount();
        });
    }

    void StateButtonClicked()
    {
        var adminurl = "administration/account/users/manage";
        if (homeGenericState.IsAdmin)
            NavManager.NavigateTo($"{adminurl}/{homeGenericState.StateName}");
    }

    async Task SaveChanges()
    {
        Loading = true;

        try
        {
            var result = await accountService.UpdateUserProfileAsync(ChangeUserClaim);

            var userEmail = (await userAuthState!).User.Claims.FirstOrDefault(_ => _.Type == ClaimTypes.Email)!.Value;
            var userData = await accountService.GetUserWithClaimEmailAsync(userEmail);

            await accountService.SaveActivityTrackerAsync(new ActivityTrackerRequestDTO()
                {
                    UserId = userData.UserId,
                    Title = "Update User Account Method called",
                    Description = result.message,
                    Date = DateTime.Now,
                    OperationState = result.flag.ToString()
                });

            if (result.flag)
            {
                Loading = false;
                CloseModalDialog();
                await InvokeAsync(() => StateHasChanged());
                await ToastComponent!.ShowSuccessToast("Updated User Account", result.message);
            }
            else
            {
                Loading = false;
                await InvokeAsync(() => StateHasChanged());
                await ToastComponent!.ShowSuccessToast("Failed To Update Permission", result.message);
            }
        }
        catch (Exception ex)
        {
            throw;
        }
    }

    async Task ManageUserClicked(ClaimGetUserResponseDTO user)
    {
        ChangeUserClaim = new ClaimChangeUserRequestDTO()
        {
            UserInfo = user.UserInfo,
            UserOtherInfo = user.UserOtherInfo
        };

        OpenModal();
    }

    void CloseModalDialog()
    {
        IsOpen = false;
    }

    public void Dispose()
    {
        Loading = false;
        homeGenericState.StateChanged -= StateButtonClicked;
        passwordState.Changed -= StateHasChanged;
    }
}